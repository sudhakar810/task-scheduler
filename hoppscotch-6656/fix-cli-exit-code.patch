From 6bd50f13af8d4482a104253bf31340a69b3fdaf9 Mon Sep 17 00:00:00 2001
From: Sudhakar Yadav <sudhakar810nit@gmail.com>
Date: Fri, 30 Oct 2026 10:34:25 +0000
Subject: [PATCH] fix(cli): exit with non-zero code on invalid usage

Invalid usage (missing/unknown arguments, unknown commands or options)
printed an INVALID_ARGUMENT error but the process exited with code 0.
The `writeErr` override called `program.help()`, which exits with 0,
and the resulting CommanderError was swallowed by an empty catch.

Print the help text with `outputHelp()` (once) instead, and propagate
the CommanderError exit code via `process.exitCode`. `--help` and
`--ver` still exit with 0.

Closes #6656
---
 .../src/__tests__/e2e/commands/test.spec.ts   | 31 ++++++++++++++++++-
 packages/hoppscotch-cli/src/index.ts          | 20 ++++++++++--
 2 files changed, 47 insertions(+), 4 deletions(-)

diff --git a/packages/hoppscotch-cli/src/__tests__/e2e/commands/test.spec.ts b/packages/hoppscotch-cli/src/__tests__/e2e/commands/test.spec.ts
index 4b7a790..f6e0fa9 100644
--- a/packages/hoppscotch-cli/src/__tests__/e2e/commands/test.spec.ts
+++ b/packages/hoppscotch-cli/src/__tests__/e2e/commands/test.spec.ts
@@ -31,6 +31,32 @@ describe("hopp test [options] <file_path_or_id>", { timeout: 100000 }, () => {
         const out = getErrorCode(stderr);
         expect(out).toBe<HoppErrorCode>("INVALID_ARGUMENT");
       });
+
+      test("Exits with a non-zero code on invalid usage", async () => {
+        const invalidArgs = [
+          "",
+          "test",
+          "invalid-arg",
+          `${VALID_TEST_ARGS} --unknown-option`,
+          `${VALID_TEST_ARGS} extra-arg`,
+        ];
+
+        for (const args of invalidArgs) {
+          const { error } = await runCLI(args);
+
+          expect(error, `hopp ${args}`).toMatchObject(<ExecException>{
+            code: 1,
+          });
+        }
+      });
+
+      test("Exits with code 0 on `--help` and `--ver`", async () => {
+        for (const args of ["--help", "--ver", "test --help"]) {
+          const { error } = await runCLI(args);
+
+          expect(error, `hopp ${args}`).toBeNull();
+        }
+      });
     });
 
     describe("Supplied collection export file validations", () => {
@@ -585,10 +611,13 @@ describe("hopp test [options] <file_path_or_id>", { timeout: 100000 }, () => {
       describe("Argument parsing", () => {
         test("Errors with the code `INVALID_ARGUMENT` if no file is supplied", async () => {
           const args = `${VALID_TEST_ARGS} --env`;
-          const { stderr } = await runCLI(args);
+          const { error, stderr } = await runCLI(args);
 
           const out = getErrorCode(stderr);
           expect(out).toBe<HoppErrorCode>("INVALID_ARGUMENT");
+          expect(error).toMatchObject(<ExecException>{
+            code: 1,
+          });
         });
       });
 
diff --git a/packages/hoppscotch-cli/src/index.ts b/packages/hoppscotch-cli/src/index.ts
index 94d70ce..3b7c5bf 100644
--- a/packages/hoppscotch-cli/src/index.ts
+++ b/packages/hoppscotch-cli/src/index.ts
@@ -1,5 +1,5 @@
 import chalk from "chalk";
-import { Command } from "commander";
+import { Command, CommanderError } from "commander";
 import * as E from "fp-ts/Either";
 
 import { version } from "../package.json";
@@ -37,8 +37,17 @@ program
   .addHelpCommand(false)
   .showHelpAfterError(true);
 
+// Commander writes the error help text in several chunks, so make sure it is printed only once
+let isHelpShownOnError = false;
+
 program.exitOverride().configureOutput({
-  writeErr: (str) => program.help(),
+  // Print the help text without exiting, so the original error's exit code is preserved
+  writeErr: (str) => {
+    if (!isHelpShownOnError) {
+      isHelpShownOnError = true;
+      program.outputHelp();
+    }
+  },
   outputError: (str, write) =>
     handleError({ code: "INVALID_ARGUMENT", data: E.toError(str) }),
 });
@@ -104,5 +113,10 @@ program
 export const cli = async (args: string[]) => {
   try {
     await program.parseAsync(args);
-  } catch (e) {}
+  } catch (e) {
+    // `exitOverride()` turns Commander exits into thrown errors; propagate their exit code
+    if (e instanceof CommanderError) {
+      process.exitCode = e.exitCode;
+    }
+  }
 };
-- 
